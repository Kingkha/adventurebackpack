{
  "name": "adventurebackpack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx tsx scripts/validate-launch.ts && npx tsx scripts/generate-blog-cache.ts && npx tsx scripts/generate-blog-sitemap.ts && npx tsx scripts/validate-seo.ts && next build",
    "postbuild": "node -e \"if(process.env.VERCEL_ENV==='production'&&process.env.INDEXNOW_KEY){require('child_process').execSync('npx tsx scripts/submit-indexnow-from-sitemap.ts',{stdio:'inherit'})}else{console.log('postbuild: skipping IndexNow (not production or no key)')}\"",
    "validate:launch": "npx tsx scripts/validate-launch.ts",
    "start": "next start",
    "lint": "next lint",
    "clean-links": "npx tsx scripts/remove-broken-internal-links.ts",
    "fix-encoding": "npx tsx scripts/fix-url-encoding.ts",
    "footer:hub-pillar": "npx tsx scripts/update-footer-hub-pillar.ts",
    "indexnow": "npx tsx scripts/submit-indexnow-from-sitemap.ts",
    "indexnow:key": "npx tsx scripts/generate-indexnow-key.ts",
    "a11y": "npx --yes pa11y-ci@3 --config .pa11yci.json",
    "a11y:build": "npm run build && npm run start & SERVER_PID=$!; sleep 8; npm run a11y; EXIT=$?; kill $SERVER_PID; exit $EXIT"
  },
  "dependencies": {
    "@ai-sdk/openai": "latest",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^0.15.1",
    "ai": "latest",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^3.0.0",
    "dotenv": "^16.3.1",
    "embla-carousel-react": "8.5.1",
    "html2canvas": "^1.4.1",
    "input-otp": "1.4.1",
    "lucide": "^0.471.0",
    "lucide-react": "^0.454.0",
    "next": "14.2.16",
    "next-auth": "latest",
    "next-themes": "^0.4.4",
    "react": "^18",
    "react-day-picker": "8.10.1",
    "react-dom": "^18",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.12",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "gray-matter": "^4.0.3",
    "postcss": "^8",
    "react-markdown": "^8.0.7",
    "sharp": "^0.34.3",
    "svg2png-wasm": "^1.4.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
